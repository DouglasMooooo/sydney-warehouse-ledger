# Production workbook location is intentionally not committed.
FEISHU_SPREADSHEET_URL=
FEISHU_MAIN_SHEET_ID=
FEISHU_WEEKLY_SHEET_ID=
FEISHU_MONTHLY_SHEET_ID=
FEISHU_CURRENT_INVENTORY_SHEET_ID=

# Hosted read-only H5 deployment (all values are server-only; never NEXT_PUBLIC_*).
FEISHU_READ_ADAPTER=openapi
WAREHOUSE_READ_ADAPTER=
GOOGLE_SPREADSHEET_ID=
FEISHU_SPREADSHEET_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=
FEISHU_OAUTH_SCOPES=
WAREHOUSE_SESSION_SECRET=
WAREHOUSE_ADMIN_USERS=
WAREHOUSE_OPERATOR_USERS=
WAREHOUSE_READ_ONLY_USERS=
READ_ONLY_RELEASE=true
APP_VERSION=

# Optional private parity probe; never commit a real value.
UAT_PARITY_PRODUCT_SKU=

# Explicit local-only convenience; never enable in production.
WAREHOUSE_DEV_AUTH=false

# Public sample-data preview; requires READ_ONLY_RELEASE=true and no live credentials.
WAREHOUSE_VISUAL_DEMO=false
WAREHOUSE_GOOGLE_UAT=false

# Optional, isolated Google UAT smoke write. The service account must be shared
# only on the UAT copy; this endpoint can write only to the UAT_写入测试 tab.
WAREHOUSE_GOOGLE_WRITE_TEST=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
